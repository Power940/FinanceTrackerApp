<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PotatoUnitedCreditUnion.LoginPage">
    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" IsEnabled="False" />
    </Shell.BackButtonBehavior>

    <Grid RowDefinitions="*, 6*, *, *, *, 3*" ColumnDefinitions="*, 2*, *">

        <Image x:Name="pfp_IMG"
               Grid.Row="1" Grid.Column="1"
               WidthRequest="350" HeightRequest="350" Margin="20" Aspect="AspectFit"/>

        <Label x:Name="error_LB"
               Grid.Row="2" Grid.Column="1"
               VerticalOptions="End" HorizontalOptions="Center"
               FontSize="20" TextColor="Red"/>

        <Label x:Name="user_LB"
               Grid.Row="3" Grid.Column="1"
               Margin="10" HorizontalOptions="Center"
               FontSize="24"
               Text="test"/>

        <Entry x:Name="user_ENT"
               Grid.Row="3" Grid.Column="1"
               HeightRequest="50" Margin="10"
               FontSize="24" Placeholder="Username"
               ReturnType="Next"
               TextChanged="RemoveErrorLB"/>

        <Entry x:Name="pass_ENT"
               Grid.Row="4" Grid.Column="1"
               HeightRequest="50" Margin="10"
               FontSize="24" Placeholder="Password" IsPassword="True"
               ReturnType="Next" Completed="Pass_ENT_Completed"
               TextChanged="RemoveErrorLB"/>

        <Button x:Name="login_BTN"
                Grid.Row="4" Grid.Column="2"
                HorizontalOptions="Start" WidthRequest="50" HeightRequest="50" Margin="10"
                Text="->" Clicked="Login_BTN_Clicked"/>

        <Button x:Name="nextUser_BTN"
                Grid.Row="1" Grid.Column="2"
                HorizontalOptions="Start" WidthRequest="50" HeightRequest="50" Margin="10"
                Text="->" Clicked="NextUser_BTN_Clicked"/>

        <Button x:Name="prevUser_BTN"
                Grid.Row="1" Grid.Column="0"
                HorizontalOptions="End" WidthRequest="50" HeightRequest="50" Margin="10"
                Text="&lt;-" Clicked="PrevUser_BTN_Clicked"/>
        
    </Grid>

</ContentPage>