<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PotatoUnitedCreditUnion.LoginPage">
    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" IsEnabled="False" />
    </Shell.BackButtonBehavior>

    <VerticalStackLayout>
        <Label HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
               WidthRequest="350" HeightRequest="350" Margin="20"
               Text="PFP LATER" />
        <Entry WidthRequest="300" HeightRequest="50" Margin="10"
            Placeholder="Username" />
        <Entry WidthRequest="300" HeightRequest="50" Margin="10"
            Placeholder="Password" IsPassword="True"/>
        <Button WidthRequest="50" HeightRequest="50" Margin="10"
            Text="->" Clicked="LoginBTN_ClickedAsync"/>
    </VerticalStackLayout>

</ContentPage>