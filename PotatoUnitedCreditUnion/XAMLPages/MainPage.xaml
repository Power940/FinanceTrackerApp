<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PotatoUnitedCreditUnion.MainPage">
    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" IsEnabled="False" />
    </Shell.BackButtonBehavior>

    <AbsoluteLayout>
        <Label HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
               AbsoluteLayout.LayoutBounds="0.5, 0.2, AutoSize, AutoSize" AbsoluteLayout.LayoutFlags="PositionProportional"
               Text="Welcome!" />

        <Button x:Name="login_BTN"
                AbsoluteLayout.LayoutBounds="0.5, 0.4, AutoSize, AutoSize" AbsoluteLayout.LayoutFlags="PositionProportional"
                Text="loginPg" Clicked="Login_BTN_Clicked"/>

        <Button x:Name="daily_BTN"
                AbsoluteLayout.LayoutBounds="0.5, 0.5, AutoSize, AutoSize" AbsoluteLayout.LayoutFlags="PositionProportional"
                Text="dailyPg" Clicked="Daily_BTN_Clicked"/>

        <Button x:Name="history_BTN"
                AbsoluteLayout.LayoutBounds="0.5, 0.6, AutoSize, AutoSize" AbsoluteLayout.LayoutFlags="PositionProportional"
                Text="historyPg" Clicked="History_BTN_Clicked"/>

        <Button x:Name="goal_BTN"
                AbsoluteLayout.LayoutBounds="0.5, 0.7, AutoSize, AutoSize" AbsoluteLayout.LayoutFlags="PositionProportional"
                Text="goalPg" Clicked="Goal_BTN_Clicked"/>
    </AbsoluteLayout>

</ContentPage>
